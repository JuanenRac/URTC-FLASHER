build/
.coverage
dist/
__pycache__/
*.pyc
logs/*.log
logs/*.json
# Scratch files written by verify_qt_swd_full_chip_flash.py
_swd_fixtures_scratch/

# Real per-machine overrides, including any hmac_key_hex/slave_hmac_key_hex
# signing key of a self-built image (the tool carries no default key, so a
# key written here must never be committed). Only urtc_config.json.example -
# a placeholder, never real key material - is meant to be tracked.
urtc_config.json
# Local secrets are never committed
.env
.env.*
!.env.example

# The firmware images are not kept in git: they are the assets of the releases of URTC
# (python tools/sync_firmware.py downloads them, or the window does). Only the folder is kept.
firmware/*
!firmware/.gitkeep
