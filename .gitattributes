# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Firmware images are binary.
*.bin binary
*.elf binary

# Signed release companions keep their exact bytes (a signature covers them).
firmware/*.sig -text
firmware/*.sha256 -text
firmware/*.manifest.json -text
firmware/firmware_manifest.json -text
