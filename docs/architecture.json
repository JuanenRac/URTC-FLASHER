{
  "repo": "URTC-FLASHER",
  "ecosystem": "urtc",
  "tagline": "Updates the firmware of a URTC board over CAN and programs the whole chip over SWD/JTAG, with the image checked before anything is sent.",
  "description": "URTC-FLASHER is a Qt Quick desktop program with a command line. It speaks the CAN-OTA bootloader protocol over an SLCAN serial adapter or SocketCAN, checks the image, its manifest and its signature before anything reaches the bus, shows what is installed, flashes the main board or the expansion slave with a backup slot, and drives pyOCD or STM32CubeProgrammer for full-chip SWD/JTAG work. It is tested against a simulated bootloader; nothing has been run on a real board.",
  "columns": [
    "WHO USES IT",
    "THE FLASHER",
    "WHAT IT TALKS TO"
  ],
  "nodes": [
    {
      "id": "person",
      "column": 0,
      "level": "external",
      "title": "A person at the bench",
      "lines": [
        "the Qt Quick command deck in",
        "eight languages, or the --cli",
        "mode with no window"
      ],
      "code": [
        "qt_flasher.py",
        "urtc_flasher.py"
      ]
    },
    {
      "id": "upd",
      "column": 0,
      "level": "external",
      "title": "URTC-UPDATER",
      "lines": [
        "can hand over a firmware image",
        "whose release signature it",
        "checked; this program flashes"
      ]
    },
    {
      "id": "proto",
      "column": 1,
      "level": "tested",
      "title": "CAN-OTA protocol",
      "lines": [
        "bootloader handshake, paged",
        "transfer with ACK, HMAC chunks,",
        "end-update, readback"
      ],
      "code": [
        "flasher_protocol.py",
        "flasher_config.py"
      ]
    },
    {
