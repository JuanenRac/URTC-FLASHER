BTN_ACCEPT=Aceitar

# --- Configuração livre de ferramenta (0x1A2/0x1A3) - ver EEPROM.TXT secção 5 ---
TITLE_CONFIRM_FREE_TOOL_CONFIG=Confirmar configuração livre de ferramenta
MSG_CONFIRM_FREE_TOOL_CONFIG=Definir e guardar a configuração livre de ferramenta para:\n\n  {tool}\n\nIsto só tem efeito numa placa cujos jumpers de ID leiam 11111 (os 5 instalados) - não tem efeito em nenhuma outra placa. Persiste entre ciclos de alimentação até ser explicitamente alterada de novo. Continuar?
LOG_FREE_TOOL_SAVED_CONFIRMED=Configuração livre de ferramenta guardada e confirmada: {tool}
LOG_FREE_TOOL_MISMATCH=Configuração livre de ferramenta definida para {value}, mas a placa reporta {confirmed} - é possível que a escrita não tenha sido aplicada. Consulte de novo para verificar.
LOG_FREE_TOOL_NO_CONFIRMATION=Configuração livre de ferramenta: enviada, mas não chegou confirmação (firmware antigo, ou placa não ligada).
LOG_FREE_TOOL_SAVE_FAILED=Falha ao guardar a configuração livre de ferramenta: {e}
TITLE_FREE_TOOL_CONFIG=Configuração livre de ferramenta (pino ID 11111)
HELP_FREE_TOOL_CONFIG=Só tem efeito numa placa cujos jumpers de ID leiam 11111 (os 5 instalados) - não tem efeito em nenhuma outra placa. Ver EEPROM.TXT secção 5 para o mecanismo completo.
OPT_FREE_TOOL_NONE=0 - Nenhuma selecionada
BTN_PROGRAM=Programar

# --- Tipo de periférico + número de série (0x1A4/0x1A5) - ver EEPROM.TXT secção 6 ---
TITLE_PERIPHERAL_INFO=Tipo de periférico e número de série
HELP_PERIPHERAL_INFO=O tipo de periférico é uma constante fixa do firmware (sempre URTC) e não pode ser alterado. O número de série é uma etiqueta atribuída pelo utilizador para distinguir várias placas no mesmo barramento CAN - por predefinição 0, qualquer valor de 0 a 255 é válido.
LBL_NEW_SERIAL=Novo número de série:
LOG_PERIPHERAL_NO_RESPONSE=Tipo de periférico/série: sem resposta (firmware antigo, ou placa não ligada).
LBL_PERIPHERAL_TYPE_URTC=Tipo: URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Tipo: desconhecido (0x{value:02X})
LBL_DEVICE_SERIAL=Número de série: {serial}
LOG_PERIPHERAL_INFO=Info de periférico: {type}, série={serial}
LOG_PERIPHERAL_QUERY_FAILED=Falha ao consultar tipo de periférico/série: {e}
TITLE_INVALID_SERIAL=Número de série inválido
MSG_INVALID_SERIAL=Introduza um número inteiro de 0 a 255.
TITLE_CONFIRM_DEVICE_SERIAL=Confirmar número de série do dispositivo
MSG_CONFIRM_DEVICE_SERIAL=Definir e guardar o número de série desta placa para:\n\n  {serial}\n\nIsto é uma definição de configuração de hardware que se faz uma só vez, não algo para alterar casualmente - persiste entre ciclos de alimentação até ser explicitamente alterada de novo. Continuar?
LOG_DEVICE_SERIAL_SAVED_CONFIRMED=Número de série guardado e confirmado: {serial}
LOG_DEVICE_SERIAL_MISMATCH=Número de série definido para {value}, mas a placa reporta {confirmed} - é possível que a escrita não tenha sido aplicada. Consulte de novo para verificar.
LOG_DEVICE_SERIAL_NO_CONFIRMATION=Número de série: enviado, mas não chegou confirmação (firmware antigo, ou placa não ligada).
LOG_DEVICE_SERIAL_SAVE_FAILED=Falha ao guardar o número de série: {e}

# MLX9064x sensor variant control (0x1A6/0x1A7) - added alongside expansion_board_type
LBL_MLX_SENSOR_VARIANT=Sensor MLX9064x:
TITLE_CONFIRM_MLX_VARIANT=Confirmar variante do sensor MLX9064x
MSG_CONFIRM_MLX_VARIANT=Definir e guardar a variante do sensor MLX9064x desta placa como:\n\n  {type}\n\nIsto é uma definição de configuração de hardware única, apenas relevante quando o tipo de placa de expansão é Advanced ou Basic+MLX9064x - persiste entre ciclos de alimentação até ser explicitamente alterada de novo. Continuar?
LOG_MLX_VARIANT_NO_RESPONSE=Variante do sensor MLX9064x: sem resposta (firmware antigo, ou placa não ligada).
LOG_MLX_VARIANT_VALUE=Variante do sensor MLX9064x: {type}
LOG_MLX_VARIANT_QUERY_FAILED=Falha na consulta da variante do sensor MLX9064x: {e}
LOG_MLX_VARIANT_SAVED_CONFIRMED=Variante do sensor MLX9064x guardada e confirmada: {type}
LOG_MLX_VARIANT_MISMATCH=Variante do sensor MLX9064x definida como {value}, mas a placa reporta {confirmed} - pode ser que a escrita não tenha sido aplicada. Consulte de novo para verificar.
LOG_MLX_VARIANT_NO_CONFIRMATION=Variante do sensor MLX9064x: enviada, mas não chegou confirmação (firmware antigo, ou placa não ligada).
LOG_MLX_VARIANT_SAVE_FAILED=Falha ao guardar a variante do sensor MLX9064x: {e}

# Expansion slave CAN-OTA flashing (0x210-0x218 relay)
LBL_FLASH_TARGET=Destino do flash:
OPT_TARGET_MASTER=Esta placa (principal)
OPT_TARGET_SLAVE=Escravo de expansão
HELP_FLASH_TARGET_SLAVE=Só alcança algo numa variante de placa de expansão Advanced (TMC2209+STM32F303CBT6 ou TMC5160A+STM32F303CBT6) - retransmitido através da ponte I2C desta placa (0x210-0x218 em CANBUS.TXT), não é uma ligação direta. "Apagar F-RAM" não se aplica - o chip escravo não tem armazenamento persistente próprio.
MSG_CONFIRM_FLASH_TARGET=Prestes a flashar: {target}.
MSG_CONFIRM_DOWNGRADE=Isto ignora a própria proteção anti-rollback do bootloader para esta atualização. Continue apenas se estiver deliberadamente a instalar uma versão anterior em que confie. Continuar?
MSG_READBACK_COMPLETE=Foram lidos {size} bytes e guardados em:\n{path}

Isto irá substituir o firmware atualmente em execução. Certifique-se de que selecionou o ficheiro correto para este destino específico. Continuar?
LOG_SENDING_SLAVE_BOOTLOADER_TRIGGER=A enviar disparador de bootloader ao escravo de expansão (0x210, retransmitido por I2C)...
LOG_SENDING_SLAVE_START_UPDATE=A enviar início de atualização ao escravo de expansão (0x211)...
LOG_SLAVE_FIRMWARE_HARDWAREID=HardwareID do escravo de expansão: 0x{hw_id:08X}
LOG_SLAVE_PROGRESS=Enviados {offset}/{size} bytes ao escravo de expansão (progresso próprio reportado: {slave_pct}%)
LOG_SLAVE_TRANSFER_COMPLETE=Transferência para o escravo de expansão concluída: {size} bytes em {elapsed:.1f}s ({kbps:.1f} KB/s)
LOG_SLAVE_UPDATE_CONFIRMED=Atualização do escravo de expansão verificada e confirmada.
LOG_SLAVE_VERIFY_FAILED=O escravo de expansão reportou falha de verificação (tamanho, CRC32, HMAC ou HardwareID não correspondem no seu próprio slot de cópia de segurança).
LOG_SLAVE_VERIFY_FAILED_REASON=O escravo de expansão reportou falha de verificação: {reason}
LOG_SLAVE_GENERIC_ERROR=O escravo de expansão reportou um estado de erro genérico.

# SWD/JTAG target chip selector (main board / expansion slave)
LBL_SWD_TARGET=Chip de destino:
HELP_SWD_TARGET_SLAVE=A sonda tem de estar fisicamente ligada ao chip que for selecionado aqui - ao contrário do CAN-OTA, não existe nenhuma ponte que permita a uma única ligação alcançar ambos. O STM32F303CC (placa principal) e o STM32F303CBT6 (escravo de expansão) têm endereços/tamanhos de flash diferentes e nomes de target do pyOCD diferentes, aplicados automaticamente ao alterar esta seleção - ver PINOUT_SLAVE.txt para a localização dos pinos SWD do escravo de expansão.

# GitHub firmware download
BTN_CLOSE=Fechar
BTN_DOWNLOAD_FROM_GITHUB=Descarregar do GitHub...
BTN_DOWNLOAD_SELECTED=Descarregar selecionado
TITLE_DOWNLOAD_FROM_GITHUB=Descarregar firmware do GitHub
TITLE_FILE_EXISTS=O ficheiro já existe
MSG_GITHUB_FILE_EXISTS_OVERWRITE={name} já existe na sua pasta de firmware. Substituir pela versão do GitHub?
LBL_GITHUB_LOADING=A carregar a lista de ficheiros da última release de github.com/JuanenRac/URTC...
LBL_GITHUB_RELEASE_TAG=Release (vazio = a última):
BTN_GITHUB_LOAD=Carregar
LBL_GITHUB_EMPTY=A release não tem ficheiros de firmware (imagens .bin com os respetivos .sha256 e .manifest.json).
LBL_GITHUB_LOADED_RELEASE={count} ficheiro(s) disponível(eis) na release {tag}.
LBL_GITHUB_DOWNLOADING_NAME=A descarregar {name}...
LBL_GITHUB_DOWNLOAD_DONE={name} descarregado - agora disponível na lista de firmware acima.
LOG_GITHUB_FETCHING_LIST=A obter a lista de ficheiros de firmware do GitHub...
LOG_GITHUB_RELEASE_TAG=Release do GitHub: {tag}.
LOG_GITHUB_LIST_COUNT=O GitHub devolveu {count} ficheiro(s) de firmware.
LOG_GITHUB_DOWNLOADING=A descarregar {name} do GitHub...
LOG_GITHUB_DOWNLOAD_COMPLETE={name} descarregado ({size} bytes).
ERR_FIRMWARE_VERSION_UNKNOWN=Não é possível saber que versão é este ficheiro de firmware: não tem .manifest.json, nem versão no nome (por exemplo v0.3.3) e não foi indicada nenhuma. A versão é gravada na placa para a verificação anti-rollback e nunca é adivinhada: adicione o manifesto, mude o nome do ficheiro ou use --version MAJOR.MINOR.
LOG_BOOTLOADER_LISTENING=O bootloader está à escuta: a atualização começa de imediato.
ERR_SLAVE_NOT_IN_BOOTLOADER=O escravo de expansão não entrou no seu bootloader: a sua aplicação continua a funcionar e ignora a atualização. O firmware do escravo tem de poder reiniciar no bootloader quando lhe é pedido (um bootloader que fique por uma marca de pedido); até lá, só se pode atualizar assim um chip virgem ou com a aplicação danificada.
ERR_MANIFEST_WRONG_TARGET=Este ficheiro de firmware é de outra placa (o manifesto diz {got}, este destino é {want}): não foi enviado nada.
ERR_GITHUB_RATE_LIMITED=Foi atingido o limite de pedidos da API do GitHub (60 pedidos/hora sem autenticação) - aguarde um momento e tente de novo, ou defina a variável de ambiente GITHUB_TOKEN.
ERR_GITHUB_FORBIDDEN=O GitHub recusou o pedido (HTTP 403) por um motivo diferente do limite de pedidos - verifique a rede, o proxy ou o token.
ERR_GITHUB_SIZE_MISMATCH=O ficheiro transferido {name} está incompleto ou alterado ({got} bytes recebidos, {expected} esperados) - foi descartado, tente de novo.
ERR_GITHUB_BAD_HOST=O endereço de transferência não está no servidor de ficheiros do GitHub ({host}) - recusado.
ERR_GITHUB_NOT_FOUND=Não foi encontrada a release (ou o repositório github.com/JuanenRac/URTC) - a etiqueta pode não existir, ou ainda não foi publicada nenhuma release.
ERR_GITHUB_BAD_TAG="{tag}" não é uma etiqueta de release válida.
ERR_GITHUB_HTTP_ERROR=O GitHub devolveu um erro HTTP (código {code}).
ERR_GITHUB_NETWORK=Não foi possível contactar o GitHub - {reason}. Verifique a sua própria ligação à internet.
ERR_GITHUB_TIMEOUT=A ligação ao GitHub excedeu o tempo limite.
ERR_GITHUB_BAD_RESPONSE=A resposta do GitHub não era JSON válido - pode estar a mostrar uma página de erro em vez da listagem da release esperada.
ERR_GITHUB_UNEXPECTED_SHAPE=A resposta do GitHub não tinha o formato esperado para a listagem de uma release.
ERR_GITHUB_WRITE_FAILED=Não foi possível escrever o ficheiro descarregado - {reason}.
ERR_GITHUB_UNEXPECTED=Erro inesperado: {e}
QT_CONNECTION=LIGAÇÃO
QT_FIRMWARE_INVENTORY=INVENTÁRIO DE FIRMWARE
QT_SCAN_FIRMWARE=PROCURAR FIRMWARE
QT_VALID=VÁLIDO
QT_INVALID=INVÁLIDO
QT_UPDATE_CHECKPOINTS=PONTOS DE CONTROLO DA ATUALIZAÇÃO CAN-OTA
QT_CHECKPOINTS=1  Validar o firmware selecionado\n2  Entrar na sessão de bootloader assinado\n3  Transferir e verificar a imagem de cópia de segurança\n4  Confirmar uma finalização segura
QT_START_CAN_OTA=INICIAR CAN-OTA
QT_ACTIVITY_LOG=REGISTO DE ATIVIDADE
QT_CONFIRM_CAN_OTA=Confirmar atualização CAN-OTA
QT_CONFIRM_CAN_OTA_BODY=O firmware de aplicação selecionado será enviado para a placa ligada. Continuar?
QT_CONFIRM_FLASH=CONFIRMAR FLASH
QT_ADVANCED_DIAGNOSTICS=DIAGNÓSTICO AVANÇADO
QT_SWD_JTAG_READONLY=DESCOBERTA SWD/JTAG SÓ DE LEITURA
QT_SWD_FULL_CHIP_SECTION=PROGRAMAÇÃO COMPLETA DO CHIP (SWD/JTAG)
QT_SCAN_PROBES=PROCURAR SONDAS
QT_NOT_INSTALLED=NÃO INSTALADO
QT_NO_PROBES=Não foi detetada nenhuma sonda de depuração USB.
QT_SWD_SAFETY_NOTE=A descoberta é só de leitura. A programação completa do chip abaixo fala diretamente com o destino via SWD/JTAG (não a ligação CAN-OTA desta aplicação) - apaga e reprograma mesmo o chip completo. O modo de teste (dry run) está ativo por predefinição; reveja o registo antes de o desativar.
QT_BOARD_SNAPSHOT=ESTADO DA PLACA
QT_READ_BOARD_STATE=LER ESTADO DA PLACA
QT_BOARD_SNAPSHOT_HELP=Os diagnósticos ativos só enviam consultas documentadas de leitura. Não é alterada nenhuma definição persistente, firmware nem byte de opção.
QT_NO_BOARD_SNAPSHOT=Ainda não foi lido o estado da placa.
QT_DEVICE_CONFIG=CONFIGURAÇÃO DO DISPOSITIVO
QT_SWD_BACKUP_DIALOG_TITLE=Guardar cópia de segurança da flash como...

# --- Additional texts ---
ERR_CANCELLED_BY_USER=Cancelado pelo utilizador
ERR_UNKNOWN_REASON=motivo desconhecido
ERR_UNKNOWN_REASON_CODE=motivo desconhecido 0x{code}
ERR_BOOTLOADER_VERIFY_FAILURE=O bootloader comunicou uma falha de verificação: {reason}
ERR_BOOTLOADER_GENERIC_ERROR=O bootloader comunicou um estado de erro genérico
ERR_TIMEOUT_WAITING_CAN_ID=Tempo esgotado à espera do ID CAN 0x{can_id}
ERR_MANIFEST_MISMATCH=O MANIFESTO NÃO CORRESPONDE - {name} declara sha256={expected}, o sha256 real deste ficheiro é {actual}. Ficheiro errado, transferência corrompida ou manifesto desatualizado - a gravação é recusada.
ERR_HMAC_NOT_32_BYTES={name}: hmac_sha256 não são 32 bytes em hexadecimal
LOG_USING_PUBLISHED_SIGNATURE=A usar a assinatura publicada no manifesto (chave: {kind}).
LOG_DEV_KEY_NOTE=NOTA: assinado com a chave de desenvolvimento PÚBLICA - só o aceitam as placas cujo bootloader foi compilado com essa mesma chave.
LOG_SIGNING_LOCALLY=Sem assinatura publicada - a assinar localmente com a chave {board} de urtc_config.json.
ERR_NO_SIGNATURE_NO_KEY=Esta imagem não tem assinatura publicada (hmac_sha256 em <ficheiro>.manifest.json) e não há chave de assinatura de {board} configurada. Use uma imagem da compilação URTC (inclui o seu .manifest.json) ou, para uma imagem própria numa placa de bancada, defina "{option}" em urtc_config.json.
ERR_FIRMWARE_EMPTY=O ficheiro de firmware está vazio
ERR_FIRMWARE_TOO_BIG_MAIN=O firmware tem {size} bytes e excede o espaço principal de {max} bytes - não se envia uma atualização que o bootloader rejeitaria na mesma
ERR_PAGE_ACK_SHORT=O ACK da página {page} tinha apenas {got} bytes (esperados pelo menos 4) - provavelmente ruído no barramento corrompeu a trama
ERR_PAGE_ACK_MISMATCH=ACK de página não corresponde: esperada a página {expected}, o bootloader confirmou a {got}
ERR_BOOTLOADER_FAILURE_REASON=O bootloader comunicou uma falha: {name} - {reason}
ERR_BOOTLOADER_FAILURE=O bootloader comunicou uma falha: {name}
ERR_TIMEOUT_FINAL_VERIFICATION=Tempo esgotado à espera do resultado da verificação final
ERR_FIRMWARE_TOO_BIG_SLAVE=O firmware tem {size} bytes e excede o espaço principal de {max} bytes do escravo de expansão - não se envia uma atualização que o seu bootloader rejeitaria na mesma
ERR_SLAVE_BRIDGE_STALLED=A ponte I2C do escravo de expansão deixou de responder ({count} consultas de progresso 0x216 seguidas sem resposta) depois de enviar {offset} de {size} bytes - aborta-se em vez de continuar a enviar o resto da imagem para uma ponte bloqueada ou desligada. Verifique se o chip escravo está presente e a ligação I2C intacta, e tente de novo.
ERR_TIMEOUT_SLAVE_FINAL_VERIFICATION=Tempo esgotado à espera do resultado da verificação final do próprio escravo de expansão
ERR_TIMEOUT_SLAVE_STATUS=Tempo esgotado à espera de que o escravo de expansão comunique o estado 0x{status}
