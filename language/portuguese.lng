QTLOG_SWD_FLASH_BLOCKED=Programação do chip completo bloqueada: não está pronta (ocupado, faltam a ferramenta ou os ficheiros, ou há várias sondas e nenhuma escolhida)
QTLOG_SWD_FLASH_STARTED=Programação do chip completo iniciada
QTLOG_SWD_FLASH_DRY_RUN_COMPLETE=Simulação concluída
QTLOG_SWD_FLASH_COMPLETE=Programação do chip completo concluída
QTLOG_SWD_FLASH_FAILED=Falhou a programação do chip completo
QTLOG_SWD_FLASH_UNEXPECTED=Erro inesperado durante a programação do chip completo
QTLOG_SWD_OPTION_BYTE_CHECK_BLOCKED=Verificação dos option bytes bloqueada: requer o STM32CubeProgrammer ou há uma operação em curso
QTLOG_SWD_OPTION_BYTE_CHECK_RESULT=Resultado da verificação dos option bytes
QTLOG_BOARD_SNAPSHOT_BLOCKED=Instantâneo da placa bloqueado: ligue primeiro
QTLOG_BOARD_SNAPSHOT_STARTED=Instantâneo da placa iniciado (só consultas de leitura documentadas)
QTLOG_BOARD_SNAPSHOT_FAILED=Falhou o instantâneo da placa
QTLOG_BOARD_SNAPSHOT_COMPLETE=Instantâneo da placa concluído
QTLOG_CONFIG_WRITE_FAILED=Falhou a escrita da configuração
QTLOG_CONFIG_WRITE=Escrita da configuração
QTLOG_EXPANSION_TYPE_SAVE_BLOCKED=Tipo de placa de expansão não guardado: sem ligação, ocupado ou índice fora do intervalo
QTLOG_MLX_VARIANT_SAVE_BLOCKED=Variante do sensor MLX não guardada: sem ligação, ocupado ou índice fora do intervalo
QTLOG_FREE_TOOL_SAVE_BLOCKED=Configuração de ferramenta livre não guardada: sem ligação, ocupado ou seleção fora do intervalo
QTLOG_DEVICE_SERIAL_SAVE_BLOCKED=Número de série do dispositivo não guardado: sem ligação, ocupado ou fora do intervalo (0-255)
QTLOG_TRANSPORT_DISCONNECTED=Desligado
QTLOG_TRANSPORT_CONNECTED=Ligado
QTLOG_CONNECTION_FAILED=Falhou a ligação
QTLOG_ERROR=Escolha primeiro uma interface série ou SocketCAN
QTLOG_FLASH_STARTED=Atualização iniciada
QTLOG_CANCEL_REQUESTED=Cancelamento pedido
QTLOG_IMAGE_REFUSED=Imagem recusada
QTLOG_IMAGE_DIGEST_VERIFIED=Resumo da imagem verificado
QTLOG_IMAGE_DIGEST_RECORDED=Resumo da imagem registado (não há resumo publicado para comparar)
QTLOG_IMAGE_RELEASE_SIGNED=Assinatura da release verificada
QTLOG_IMAGE_RELEASE_UNSIGNED=Sem assinatura da release (imagem de uma pré-release de bancada)
QTLOG_LANGUAGE_SAVED=Idioma guardado
QTLOG_LANGUAGE_SAVE_FAILED=Não foi possível guardar o idioma
QTLOG_FLASH_COMPLETE=Atualização concluída
QTLOG_FLASH_FAILED=Falhou a atualização
QTLOG_FLASH_UNEXPECTED=Erro inesperado durante a atualização

# --- Additional texts ---
LBL_PROBE_NAME=Sonda: {probe}
QTLOG_AUTODETECT_FAILED=A deteção da velocidade do barramento falhou
QTLOG_GITHUB_FAILED=A transferência do GitHub falhou
QTLOG_GITHUB_DOWNLOAD_BLOCKED=Transferência do GitHub bloqueada: outra operação em curso
QTLOG_DOWNGRADE_NOT_CONFIRMED=Atualização bloqueada: a descida de versão não foi confirmada
QTLOG_FRAM_ERASE_SKIPPED=Apagamento da F-RAM ignorado: precisa da opção de entrada no bootloader
QTLOG_READBACK_BLOCKED=Cópia bloqueada: ligue à placa principal e aguarde o fim da operação em curso
QTLOG_READBACK_STARTED=Cópia do firmware por CAN iniciada
QTLOG_READBACK_COMPLETE=Cópia do firmware concluída
QTLOG_READBACK_FAILED=A cópia do firmware falhou
QTLOG_READBACK_UNEXPECTED=Erro inesperado durante a cópia do firmware
QTLOG_BUS_ACTIVITY_BLOCKED=Verificação da atividade do bus bloqueada: ligue primeiro e aguarde a operação em curso
QTLOG_BUS_ACTIVITY_FAILED=A verificação da atividade do bus falhou
QTLOG_BUS_ACTIVITY=Atividade do bus
QTLOG_DEBUG_BUNDLE_EXPORTED=Pacote de depuração guardado
QTLOG_DEBUG_BUNDLE_FAILED=Não foi possível guardar o pacote de depuração
QTLOG_UPDATE_REPORT_WRITTEN=Relatório de atualização escrito
QTLOG_UPDATE_REPORT_FAILED=Não foi possível escrever o relatório de atualização
QTLOG_RECOVERY_IMAGE_SELECTED=A placa não tem firmware válido: foi selecionada a imagem oficial mais recente
QTLOG_FIRMWARE_SELECTED_DESPITE_WARNING=Ficheiro selecionado, embora não pareça uma imagem válida
QTLOG_LOG_SAVED=Registo guardado
QTLOG_LOG_SAVE_FAILED=Não foi possível guardar o registo
QTLOG_GITHUB_DOWNLOADED=Transferido do GitHub
