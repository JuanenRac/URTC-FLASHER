# --- Configurazione libera dello strumento (0x1A2/0x1A3) - vedi EEPROM.TXT sezione 5 ---
TITLE_CONFIRM_FREE_TOOL_CONFIG=Conferma configurazione libera dello strumento
MSG_CONFIRM_FREE_TOOL_CONFIG=Imposta e salva la configurazione libera dello strumento a:\n\n  {tool}\n\nQuesto ha effetto solo su una scheda i cui jumper ID leggono 11111 (tutti e 5 installati) - non ha effetto su nessun'altra scheda. Persiste tra i cicli di alimentazione finche non viene esplicitamente cambiata di nuovo. Procedere?
LOG_FREE_TOOL_SAVED_CONFIRMED=Configurazione libera dello strumento salvata e confermata: {tool}
LOG_FREE_TOOL_MISMATCH=Configurazione libera dello strumento impostata a {value}, ma la scheda riporta {confirmed} - la scrittura potrebbe non essere andata a buon fine. Interroga di nuovo per verificare.
LOG_FREE_TOOL_NO_CONFIRMATION=Configurazione libera dello strumento: inviata, ma nessuna conferma ricevuta (firmware datato, o scheda non connessa).
LOG_FREE_TOOL_SAVE_FAILED=Salvataggio della configurazione libera dello strumento non riuscito: {e}
TITLE_FREE_TOOL_CONFIG=Configurazione libera dello strumento (ID pin 11111)
HELP_FREE_TOOL_CONFIG=Ha effetto solo su una scheda i cui jumper ID leggono 11111 (tutti e 5 installati) - non ha effetto su nessun'altra scheda. Vedi EEPROM.TXT sezione 5 per il meccanismo completo.
OPT_FREE_TOOL_NONE=0 - Nessuno selezionato
BTN_PROGRAM=Programma

# --- Tipo di periferica + numero di serie (0x1A4/0x1A5) - vedi EEPROM.TXT sezione 6 ---
TITLE_PERIPHERAL_INFO=Tipo di periferica e numero di serie
HELP_PERIPHERAL_INFO=Il tipo di periferica e una costante fissa del firmware (sempre URTC) e non puo essere modificato. Il numero di serie e un'etichetta assegnata dall'utente per distinguere piu schede sullo stesso bus CAN - predefinito 0, qualsiasi valore da 0 a 255 e valido.
LBL_NEW_SERIAL=Nuovo numero di serie:
LOG_PERIPHERAL_NO_RESPONSE=Tipo di periferica/serie: nessuna risposta (firmware datato, o scheda non connessa).
LBL_PERIPHERAL_TYPE_URTC=Tipo: URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Tipo: sconosciuto (0x{value:02X})
LBL_DEVICE_SERIAL=Numero di serie: {serial}
LOG_PERIPHERAL_INFO=Info periferica: {type}, serie={serial}
LOG_PERIPHERAL_QUERY_FAILED=Interrogazione tipo di periferica/serie non riuscita: {e}
TITLE_INVALID_SERIAL=Numero di serie non valido
MSG_INVALID_SERIAL=Inserisci un numero intero da 0 a 255.
TITLE_CONFIRM_DEVICE_SERIAL=Conferma numero di serie del dispositivo
MSG_CONFIRM_DEVICE_SERIAL=Imposta e salva il numero di serie di questa scheda a:\n\n  {serial}\n\nQuesta e un'impostazione di configurazione hardware una tantum, non qualcosa da cambiare con leggerezza - persiste tra i cicli di alimentazione finche non viene esplicitamente cambiata di nuovo. Procedere?
LOG_DEVICE_SERIAL_SAVED_CONFIRMED=Numero di serie salvato e confermato: {serial}
LOG_DEVICE_SERIAL_MISMATCH=Numero di serie impostato a {value}, ma la scheda riporta {confirmed} - la scrittura potrebbe non essere andata a buon fine. Interroga di nuovo per verificare.
LOG_DEVICE_SERIAL_NO_CONFIRMATION=Numero di serie: inviato, ma nessuna conferma ricevuta (firmware datato, o scheda non connessa).
LOG_DEVICE_SERIAL_SAVE_FAILED=Salvataggio del numero di serie non riuscito: {e}

# MLX9064x sensor variant control (0x1A6/0x1A7) - added alongside expansion_board_type
LBL_MLX_SENSOR_VARIANT=Sensore MLX9064x:
TITLE_CONFIRM_MLX_VARIANT=Conferma variante sensore MLX9064x
MSG_CONFIRM_MLX_VARIANT=Imposta e salva la variante del sensore MLX9064x di questa scheda su:\n\n  {type}\n\nQuesta e un'impostazione di configurazione hardware una tantum, rilevante solo quando il tipo di scheda di espansione e Advanced o Basic+MLX9064x - persiste tra i cicli di accensione fino a quando non viene modificata di nuovo esplicitamente. Procedere?
LOG_MLX_VARIANT_NO_RESPONSE=Variante sensore MLX9064x: nessuna risposta (firmware precedente, o scheda non connessa).
LOG_MLX_VARIANT_VALUE=Variante sensore MLX9064x: {type}
LOG_MLX_VARIANT_QUERY_FAILED=Interrogazione variante sensore MLX9064x non riuscita: {e}
LOG_MLX_VARIANT_SAVED_CONFIRMED=Variante sensore MLX9064x salvata e confermata: {type}
LOG_MLX_VARIANT_MISMATCH=Variante sensore MLX9064x impostata su {value}, ma la scheda riporta {confirmed} - la scrittura potrebbe non essere andata a buon fine. Interroga di nuovo per verificare.
LOG_MLX_VARIANT_NO_CONFIRMATION=Variante sensore MLX9064x: inviato, ma nessuna conferma ricevuta (firmware precedente, o scheda non connessa).
LOG_MLX_VARIANT_SAVE_FAILED=Salvataggio variante sensore MLX9064x non riuscito: {e}

# Expansion slave CAN-OTA flashing (0x210-0x218 relay)
LBL_FLASH_TARGET=Destinazione flash:
OPT_TARGET_MASTER=Questa scheda (principale)
OPT_TARGET_SLAVE=Slave di espansione
HELP_FLASH_TARGET_SLAVE=Raggiunge qualcosa solo su una variante di scheda di espansione Advanced (TMC2209+STM32F303CBT6 o TMC5160A+STM32F303CBT6) - inoltrato tramite il bridge I2C di questa scheda (0x210-0x218 in CANBUS.TXT), non una connessione diretta. "Cancella F-RAM" non si applica ad esso - il chip slave non ha memoria persistente propria.
MSG_CONFIRM_FLASH_TARGET=Stai per flashare: {target}.
MSG_CONFIRM_DOWNGRADE=Questo bypassa la protezione anti-rollback del bootloader per questo aggiornamento. Procedi solo se stai installando deliberatamente una versione precedente di cui ti fidi. Continuare?
MSG_READBACK_COMPLETE=Letti {size} byte e salvati in:\n{path}

Questo sovrascrivera il firmware attualmente in esecuzione. Assicurati di aver selezionato il file corretto per questa specifica destinazione. Continuare?
LOG_SENDING_SLAVE_BOOTLOADER_TRIGGER=Invio trigger bootloader allo slave di espansione (0x210, inoltrato via I2C)...
LOG_SENDING_SLAVE_START_UPDATE=Invio avvio aggiornamento allo slave di espansione (0x211)...
LOG_SLAVE_FIRMWARE_HARDWAREID=HardwareID dello slave di espansione: 0x{hw_id:08X}
LOG_SLAVE_PROGRESS=Inviati {offset}/{size} byte allo slave di espansione (progresso proprio riportato: {slave_pct}%)
LOG_SLAVE_TRANSFER_COMPLETE=Trasferimento allo slave di espansione completato: {size} byte in {elapsed:.1f}s ({kbps:.1f} KB/s)
LOG_SLAVE_UPDATE_CONFIRMED=Aggiornamento dello slave di espansione verificato e confermato.
LOG_SLAVE_VERIFY_FAILED=Lo slave di espansione ha segnalato un errore di verifica (dimensione, CRC32, HMAC o HardwareID non corrispondenti nel proprio slot di backup).
LOG_SLAVE_VERIFY_FAILED_REASON=Lo slave di espansione ha segnalato un errore di verifica: {reason}
LOG_SLAVE_GENERIC_ERROR=Lo slave di espansione ha segnalato uno stato di errore generico.

# SWD/JTAG target chip selector (main board / expansion slave)
LBL_SWD_TARGET=Chip di destinazione:
HELP_SWD_TARGET_SLAVE=La sonda deve essere fisicamente collegata al chip impostato qui - a differenza di CAN-OTA, non esiste un bridge che permetta a una sola connessione di raggiungere entrambi. STM32F303CC (scheda principale) e STM32F303CBT6 (slave di espansione) hanno indirizzi/dimensioni flash diversi e nomi target pyOCD diversi, applicati automaticamente al cambio di questa selezione - vedi PINOUT_SLAVE.txt per la posizione dei pin SWD dello slave di espansione.

