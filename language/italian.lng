QTLOG_IMAGE_RELEASE_SIGNED=Firma della release verificata
QTLOG_IMAGE_RELEASE_UNSIGNED=Nessuna firma della release (immagine di una pre-release da banco)
QTLOG_LANGUAGE_SAVED=Lingua salvata
QTLOG_LANGUAGE_SAVE_FAILED=Impossibile salvare la lingua
QTLOG_FLASH_COMPLETE=Aggiornamento completato
QTLOG_FLASH_FAILED=Aggiornamento non riuscito
