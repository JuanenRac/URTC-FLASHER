LBL_RETRY_PLURAL=tentativi
LOG_TRANSFER_COMPLETE=Trasferimento completato: {size} byte in {elapsed:.1f}s ({kbps:.1f} KB/s in media, {retries} {retry_word} di ACK pagina)
LOG_FAILED=FALLITO: {e}
LOG_UNEXPECTED_ERROR=ERRORE IMPREVISTO: {e}
LOG_NO_VERIFICATION_FRAME_CHECKING=Nessun frame di verifica visto entro il timeout - verifica se la scheda e gia in esecuzione (il frame di conferma stesso potrebbe essere andato perso nel reset)...
LOG_BOARD_RESPONDING_AS_APP=La scheda sta rispondendo come applicazione - l'aggiornamento probabilmente e riuscito anche se il suo frame di conferma e andato perso.
LOG_FLASHER_READY=URTC Flasher pronto. HardwareID: 0x{hw_id:08X}
LOG_EXPECTING_SLCAN_MODE=Si attende l'adattatore in modalita SLCAN - vedi il README se il tuo CANable appare come qualcosa di diverso da una porta seriale.
LOG_EXPECTING_SOCKETCAN_MODE=Modalita SocketCAN - si attende che l'interfaccia sia gia attiva a 500 kbit/s (ip link set ... up type can bitrate 500000). Vedi la sezione Linux del README.
LOG_DEBUG_BUNDLE_EXPORTED=Pacchetto di debug esportato in {path}
LOG_NO_SOCKETCAN_INTERFACES=Nessuna interfaccia SocketCAN trovata. Attivane una prima, es.:\n    sudo ip link set can0 type can bitrate 500000\n    sudo ip link set can0 up
LOG_CONNECTED_TO_PORT=Connesso a {port}, canale CAN aperto
LOG_AT_BITRATE_SUFFIX= a {bitrate}.
LOG_NO_FIRMWARE_FOLDER=Nessuna cartella firmware/ trovata dentro tools/ (cercato in: {folder}). Usa Sfoglia in alternativa, oppure crea quella cartella e mettici un .bin.
LOG_FIRMWARE_FOLDER_NO_BINS=Cartella firmware/ trovata ma senza file .bin al suo interno ({folder}).
LOG_SCANNED_FIRMWARE=Scansionata firmware/: {found} file trovati, {valid} sembrano validi.
LOG_FIRMWARE_ENTRY_INVALID=  ✗ {name}: {reason}
LOG_AUTO_SELECTED_FIRMWARE=Selezionato automaticamente l'unico firmware valido trovato: {name}
LOG_AUTODETECT_TRYING=Rilevamento automatico: provo {label}...
LOG_AUTODETECT_RESPONDED=Rilevamento automatico: traffico CAN ascoltato a {label}.
LOG_AUTODETECT_NO_RESPONSE=Rilevamento automatico: nessun traffico CAN a nessuna velocita bus standard. Il rilevamento automatico ascolta soltanto (non trasmette mai, quindi non puo disturbare un bus in funzione) e richiede che altri nodi stiano trasmettendo; con il bus silenzioso scegli la velocita a mano (URTC usa 500 kbit/s).
LOG_BUS_ACTIVITY_CHECK_ERROR=Verifica attivita bus: {e}
LBL_FRAMES_IN_2S={count} frame in 2s (~{rate:.1f}/s)
LOG_BUS_ACTIVITY=Attivita bus: {text}
LOG_SOCKETCAN_COUNTERS_DELTA=  Contatori interfaccia SocketCAN (delta 2s): {deltas}
LOG_EXPANSION_TYPE_VALUE=Tipo di scheda di espansione: {type}
LOG_EXPANSION_TYPE_QUERY_FAILED=Interrogazione del tipo di scheda di espansione non riuscita: {e}
LOG_EXPANSION_TYPE_SAVED_CONFIRMED=Tipo di scheda di espansione salvato e confermato: {type}
LOG_EXPANSION_TYPE_MISMATCH=Tipo di scheda di espansione impostato a {value}, ma la scheda riporta {confirmed} - la scrittura potrebbe non essere andata a buon fine. Interroga di nuovo per verificare.
LOG_EXPANSION_TYPE_NO_CONFIRMATION=Tipo di scheda di espansione: inviato, ma nessuna conferma ricevuta (firmware datato, o scheda non connessa).
LOG_EXPANSION_TYPE_SAVE_FAILED=Salvataggio del tipo di scheda di espansione non riuscito: {e}
LOG_CURRENT_VERSION_QUERY=Interrogazione versione attuale: {text}
LOG_SKIPPING_FRAM_ERASE=Cancellazione F-RAM saltata: richiede che l'applicazione sia in esecuzione (la casella di trigger sopra non e selezionata, quindi si presume che la scheda sia gia nel bootloader, che non gestisce questo comando).
LOG_IMAGE_DIGEST=SHA-256 dell'immagine: {sha}
LOG_IMAGE_DIGEST_VERIFIED=Lo SHA-256 dell'immagine corrisponde a quello pubblicato: {sha}
LOG_IMAGE_REFUSED=Flash rifiutato: {reasons}
TITLE_CONFIRM_EXPANSION_BOARD_TYPE=Conferma tipo di scheda di espansione
MSG_CONFIRM_EXPANSION_BOARD_TYPE=Imposta e salva il tipo di scheda di espansione di questa scheda a:\n\n  {type}\n\nQuesta e un'impostazione di configurazione hardware una tantum, non qualcosa da cambiare con leggerezza - persiste tra i cicli di alimentazione finche non viene esplicitamente cambiata di nuovo. Procedere?
TITLE_CONFIRM_FLASH=Conferma programmazione
TITLE_CONFIRM_DOWNGRADE=Conferma downgrade
TITLE_SAVE_READBACK=Salva Backup Firmware
MSG_CONFIRM_FLASH=Questo cancellera lo slot di backup e, una volta verificato, sostituira lo slot dell'applicazione principale con questo firmware.\n\nIl firmware attualmente in esecuzione rimane intatto finche la nuova immagine non e completamente verificata, quindi e sicuro riprovare in caso di fallimento - ma controlla bene di aver selezionato il file giusto.\n\nProcedere?

