# --- Configurazione libera dello strumento (0x1A2/0x1A3) - vedi EEPROM.TXT sezione 5 ---
TITLE_CONFIRM_FREE_TOOL_CONFIG=Conferma configurazione libera dello strumento
MSG_CONFIRM_FREE_TOOL_CONFIG=Imposta e salva la configurazione libera dello strumento a:\n\n  {tool}\n\nQuesto ha effetto solo su una scheda i cui jumper ID leggono 11111 (tutti e 5 installati) - non ha effetto su nessun'altra scheda. Persiste tra i cicli di alimentazione finche non viene esplicitamente cambiata di nuovo. Procedere?
LOG_FREE_TOOL_SAVED_CONFIRMED=Configurazione libera dello strumento salvata e confermata: {tool}
LOG_FREE_TOOL_MISMATCH=Configurazione libera dello strumento impostata a {value}, ma la scheda riporta {confirmed} - la scrittura potrebbe non essere andata a buon fine. Interroga di nuovo per verificare.
LOG_FREE_TOOL_NO_CONFIRMATION=Configurazione libera dello strumento: inviata, ma nessuna conferma ricevuta (firmware datato, o scheda non connessa).
LOG_FREE_TOOL_SAVE_FAILED=Salvataggio della configurazione libera dello strumento non riuscito: {e}
TITLE_FREE_TOOL_CONFIG=Configurazione libera dello strumento (ID pin 11111)
HELP_FREE_TOOL_CONFIG=Ha effetto solo su una scheda i cui jumper ID leggono 11111 (tutti e 5 installati) - non ha effetto su nessun'altra scheda. Vedi EEPROM.TXT sezione 5 per il meccanismo completo.
OPT_FREE_TOOL_NONE=0 - Nessuno selezionato
BTN_PROGRAM=Programma

# --- Tipo di periferica + numero di serie (0x1A4/0x1A5) - vedi EEPROM.TXT sezione 6 ---
TITLE_PERIPHERAL_INFO=Tipo di periferica e numero di serie
HELP_PERIPHERAL_INFO=Il tipo di periferica e una costante fissa del firmware (sempre URTC) e non puo essere modificato. Il numero di serie e un'etichetta assegnata dall'utente per distinguere piu schede sullo stesso bus CAN - predefinito 0, qualsiasi valore da 0 a 255 e valido.
LBL_NEW_SERIAL=Nuovo numero di serie:
LOG_PERIPHERAL_NO_RESPONSE=Tipo di periferica/serie: nessuna risposta (firmware datato, o scheda non connessa).
LBL_PERIPHERAL_TYPE_URTC=Tipo: URTC (0x03)
LBL_PERIPHERAL_TYPE_UNKNOWN=Tipo: sconosciuto (0x{value:02X})
LBL_DEVICE_SERIAL=Numero di serie: {serial}
LOG_PERIPHERAL_INFO=Info periferica: {type}, serie={serial}
LOG_PERIPHERAL_QUERY_FAILED=Interrogazione tipo di periferica/serie non riuscita: {e}
TITLE_INVALID_SERIAL=Numero di serie non valido
MSG_INVALID_SERIAL=Inserisci un numero intero da 0 a 255.
TITLE_CONFIRM_DEVICE_SERIAL=Conferma numero di serie del dispositivo
MSG_CONFIRM_DEVICE_SERIAL=Imposta e salva il numero di serie di questa scheda a:\n\n  {serial}\n\nQuesta e un'impostazione di configurazione hardware una tantum, non qualcosa da cambiare con leggerezza - persiste tra i cicli di alimentazione finche non viene esplicitamente cambiata di nuovo. Procedere?
LOG_DEVICE_SERIAL_SAVED_CONFIRMED=Numero di serie salvato e confermato: {serial}
LOG_DEVICE_SERIAL_MISMATCH=Numero di serie impostato a {value}, ma la scheda riporta {confirmed} - la scrittura potrebbe non essere andata a buon fine. Interroga di nuovo per verificare.
LOG_DEVICE_SERIAL_NO_CONFIRMATION=Numero di serie: inviato, ma nessuna conferma ricevuta (firmware datato, o scheda non connessa).
LOG_DEVICE_SERIAL_SAVE_FAILED=Salvataggio del numero di serie non riuscito: {e}

# MLX9064x sensor variant control (0x1A6/0x1A7) - added alongside expansion_board_type
LBL_MLX_SENSOR_VARIANT=Sensore MLX9064x:
TITLE_CONFIRM_MLX_VARIANT=Conferma variante sensore MLX9064x
MSG_CONFIRM_MLX_VARIANT=Imposta e salva la variante del sensore MLX9064x di questa scheda su:\n\n  {type}\n\nQuesta e un'impostazione di configurazione hardware una tantum, rilevante solo quando il tipo di scheda di espansione e Advanced o Basic+MLX9064x - persiste tra i cicli di accensione fino a quando non viene modificata di nuovo esplicitamente. Procedere?
LOG_MLX_VARIANT_NO_RESPONSE=Variante sensore MLX9064x: nessuna risposta (firmware precedente, o scheda non connessa).
LOG_MLX_VARIANT_VALUE=Variante sensore MLX9064x: {type}
LOG_MLX_VARIANT_QUERY_FAILED=Interrogazione variante sensore MLX9064x non riuscita: {e}
LOG_MLX_VARIANT_SAVED_CONFIRMED=Variante sensore MLX9064x salvata e confermata: {type}
LOG_MLX_VARIANT_MISMATCH=Variante sensore MLX9064x impostata su {value}, ma la scheda riporta {confirmed} - la scrittura potrebbe non essere andata a buon fine. Interroga di nuovo per verificare.
LOG_MLX_VARIANT_NO_CONFIRMATION=Variante sensore MLX9064x: inviato, ma nessuna conferma ricevuta (firmware precedente, o scheda non connessa).
LOG_MLX_VARIANT_SAVE_FAILED=Salvataggio variante sensore MLX9064x non riuscito: {e}

# Expansion slave CAN-OTA flashing (0x210-0x218 relay)
LBL_FLASH_TARGET=Destinazione flash:
OPT_TARGET_MASTER=Questa scheda (principale)
OPT_TARGET_SLAVE=Slave di espansione
HELP_FLASH_TARGET_SLAVE=Raggiunge qualcosa solo su una variante di scheda di espansione Advanced (TMC2209+STM32F303CBT6 o TMC5160A+STM32F303CBT6) - inoltrato tramite il bridge I2C di questa scheda (0x210-0x218 in CANBUS.TXT), non una connessione diretta. "Cancella F-RAM" non si applica ad esso - il chip slave non ha memoria persistente propria.
MSG_CONFIRM_FLASH_TARGET=Stai per flashare: {target}.
MSG_CONFIRM_DOWNGRADE=Questo bypassa la protezione anti-rollback del bootloader per questo aggiornamento. Procedi solo se stai installando deliberatamente una versione precedente di cui ti fidi. Continuare?
MSG_READBACK_COMPLETE=Letti {size} byte e salvati in:\n{path}

Questo sovrascrivera il firmware attualmente in esecuzione. Assicurati di aver selezionato il file corretto per questa specifica destinazione. Continuare?
LOG_SENDING_SLAVE_BOOTLOADER_TRIGGER=Invio trigger bootloader allo slave di espansione (0x210, inoltrato via I2C)...
LOG_SENDING_SLAVE_START_UPDATE=Invio avvio aggiornamento allo slave di espansione (0x211)...
LOG_SLAVE_FIRMWARE_HARDWAREID=HardwareID dello slave di espansione: 0x{hw_id:08X}
LOG_SLAVE_PROGRESS=Inviati {offset}/{size} byte allo slave di espansione (progresso proprio riportato: {slave_pct}%)
LOG_SLAVE_TRANSFER_COMPLETE=Trasferimento allo slave di espansione completato: {size} byte in {elapsed:.1f}s ({kbps:.1f} KB/s)
LOG_SLAVE_UPDATE_CONFIRMED=Aggiornamento dello slave di espansione verificato e confermato.
LOG_SLAVE_VERIFY_FAILED=Lo slave di espansione ha segnalato un errore di verifica (dimensione, CRC32, HMAC o HardwareID non corrispondenti nel proprio slot di backup).
LOG_SLAVE_VERIFY_FAILED_REASON=Lo slave di espansione ha segnalato un errore di verifica: {reason}
LOG_SLAVE_GENERIC_ERROR=Lo slave di espansione ha segnalato uno stato di errore generico.

# SWD/JTAG target chip selector (main board / expansion slave)
LBL_SWD_TARGET=Chip di destinazione:
HELP_SWD_TARGET_SLAVE=La sonda deve essere fisicamente collegata al chip impostato qui - a differenza di CAN-OTA, non esiste un bridge che permetta a una sola connessione di raggiungere entrambi. STM32F303CC (scheda principale) e STM32F303CBT6 (slave di espansione) hanno indirizzi/dimensioni flash diversi e nomi target pyOCD diversi, applicati automaticamente al cambio di questa selezione - vedi PINOUT_SLAVE.txt per la posizione dei pin SWD dello slave di espansione.

# GitHub firmware download
BTN_CLOSE=Chiudi
BTN_DOWNLOAD_FROM_GITHUB=Scarica da GitHub...
BTN_DOWNLOAD_SELECTED=Scarica Selezionato
TITLE_DOWNLOAD_FROM_GITHUB=Scarica Firmware da GitHub
TITLE_FILE_EXISTS=Il File Esiste Gia
MSG_GITHUB_FILE_EXISTS_OVERWRITE={name} esiste gia nella tua cartella firmware. Sovrascriverlo con la versione da GitHub?
LBL_GITHUB_LOADING=Caricamento dell'elenco dei file dell'ultima release da github.com/JuanenRac/URTC...
LBL_GITHUB_RELEASE_TAG=Release (vuoto = l'ultima):
BTN_GITHUB_LOAD=Carica
LBL_GITHUB_EMPTY=La release non contiene file di firmware (immagini .bin con i relativi .sha256 e .manifest.json).
LBL_GITHUB_LOADED_RELEASE={count} file disponibile/i nella release {tag}.
LBL_GITHUB_DOWNLOADING_NAME=Scaricamento di {name}...
LBL_GITHUB_DOWNLOAD_DONE={name} scaricato - ora disponibile nell'elenco firmware sopra.
LOG_GITHUB_FETCHING_LIST=Recupero elenco file firmware da GitHub...
LOG_GITHUB_RELEASE_TAG=Release GitHub: {tag}.
LOG_GITHUB_LIST_COUNT=GitHub ha restituito {count} file firmware.
LOG_GITHUB_DOWNLOADING=Scaricamento di {name} da GitHub...
LOG_GITHUB_DOWNLOAD_COMPLETE={name} scaricato ({size} byte).
ERR_FIRMWARE_VERSION_UNKNOWN=Non si puo sapere quale versione sia questo file firmware: non ha .manifest.json, ne versione nel nome (ad esempio v0.3.3) e non ne e stata data nessuna. La versione viene scritta nella scheda per il controllo anti-rollback e non si indovina mai: aggiungi il manifesto, rinomina il file o usa --version MAGGIORE.MINORE.
LOG_BOOTLOADER_LISTENING=Il bootloader e in ascolto: l'aggiornamento parte subito.
ERR_SLAVE_NOT_IN_BOOTLOADER=Lo slave di espansione non e entrato nel suo bootloader: la sua applicazione e ancora in esecuzione e ignora l'aggiornamento. Il firmware dello slave deve poter riavviarsi nel bootloader su richiesta; finche non lo fa, in questo modo si aggiorna solo un chip vergine o con l'applicazione danneggiata.
ERR_MANIFEST_WRONG_TARGET=Questo file firmware e per un'altra scheda (il manifesto dice {got}, questa destinazione e {want}): non e stato inviato nulla.
ERR_GITHUB_RATE_LIMITED=Raggiunto il limite di frequenza dell'API GitHub (60 richieste/ora senza autenticazione) - attendi e riprova, oppure imposta la variabile d'ambiente GITHUB_TOKEN.
ERR_GITHUB_FORBIDDEN=GitHub ha rifiutato la richiesta (HTTP 403) per un motivo diverso dal limite di frequenza - controlla rete, proxy o token.
ERR_GITHUB_SIZE_MISMATCH=Il file scaricato {name} e incompleto o alterato ({got} byte ricevuti, {expected} attesi) - e stato scartato, riprova.
ERR_GITHUB_BAD_HOST=L'indirizzo di download non e sull'host dei file di GitHub ({host}) - rifiutato.
ERR_GITHUB_NOT_FOUND=La release (o il repository github.com/JuanenRac/URTC) non e stata trovata - il tag potrebbe non esistere o non e ancora stata pubblicata nessuna release.
ERR_GITHUB_BAD_TAG="{tag}" non e un tag di release valido.
ERR_GITHUB_HTTP_ERROR=GitHub ha restituito un errore HTTP (codice {code}).
ERR_GITHUB_NETWORK=Impossibile raggiungere GitHub - {reason}. Controlla la tua connessione internet.
ERR_GITHUB_TIMEOUT=Timeout della connessione a GitHub.
ERR_GITHUB_BAD_RESPONSE=La risposta di GitHub non era JSON valido - potrebbe mostrare una pagina di errore invece dell'elenco della release atteso.
ERR_GITHUB_UNEXPECTED_SHAPE=La risposta di GitHub non aveva il formato atteso per l'elenco di una release.
ERR_GITHUB_WRITE_FAILED=Impossibile scrivere il file scaricato - {reason}.
ERR_GITHUB_UNEXPECTED=Errore imprevisto: {e}
QT_CONNECTION=CONNESSIONE
QT_FIRMWARE_INVENTORY=INVENTARIO FIRMWARE
QT_SCAN_FIRMWARE=SCANSIONA FIRMWARE
QT_VALID=VALIDO
QT_INVALID=NON VALIDO
QT_UPDATE_CHECKPOINTS=PUNTI DI CONTROLLO AGGIORNAMENTO CAN-OTA
QT_CHECKPOINTS=1  Convalida il firmware selezionato\n2  Entra nella sessione bootloader firmata\n3  Trasferisci e verifica l'immagine di backup\n4  Conferma il completamento sicuro
QT_START_CAN_OTA=AVVIA CAN-OTA
QT_ACTIVITY_LOG=REGISTRO ATTIVITA
QT_CONFIRM_CAN_OTA=Conferma aggiornamento CAN-OTA
QT_CONFIRM_CAN_OTA_BODY=Il firmware applicativo selezionato verra inviato alla scheda connessa. Continuare?
QT_CONFIRM_FLASH=CONFERMA FLASH
QT_ADVANCED_DIAGNOSTICS=DIAGNOSTICA AVANZATA
QT_SWD_JTAG_READONLY=RILEVAMENTO SWD/JTAG IN SOLA LETTURA
QT_SWD_FULL_CHIP_SECTION=PROGRAMMAZIONE COMPLETA DEL CHIP (SWD/JTAG)
QT_SCAN_PROBES=CERCA SONDE
QT_NOT_INSTALLED=NON INSTALLATO
QT_NO_PROBES=Nessuna sonda di debug USB rilevata.
QT_SWD_SAFETY_NOTE=Il rilevamento e in sola lettura. La programmazione completa del chip qui sotto comunica direttamente con il target via SWD/JTAG (non la connessione CAN-OTA di questa app) - cancella e riprogramma davvero l'intero chip. La modalita a vuoto e attiva per impostazione predefinita; controllare il log prima di disattivarla.
QT_BOARD_SNAPSHOT=STATO SCHEDA
QT_READ_BOARD_STATE=LEGGI STATO SCHEDA
QT_BOARD_SNAPSHOT_HELP=La diagnostica attiva invia solo richieste documentate di lettura. Nessuna impostazione persistente, firmware o byte opzione viene modificato.
QT_NO_BOARD_SNAPSHOT=Lo stato della scheda non e stato ancora letto.
QT_DEVICE_CONFIG=CONFIGURAZIONE DISPOSITIVO
QT_SWD_BACKUP_DIALOG_TITLE=Salva backup flash come...

# --- Additional texts ---
ERR_CANCELLED_BY_USER=Annullato dall'utente
ERR_UNKNOWN_REASON=motivo sconosciuto
ERR_UNKNOWN_REASON_CODE=motivo sconosciuto 0x{code}
ERR_BOOTLOADER_VERIFY_FAILURE=Il bootloader ha segnalato un errore di verifica: {reason}
ERR_BOOTLOADER_GENERIC_ERROR=Il bootloader ha segnalato uno stato di errore generico
ERR_TIMEOUT_WAITING_CAN_ID=Timeout in attesa dell'ID CAN 0x{can_id}
ERR_MANIFEST_MISMATCH=IL MANIFEST NON CORRISPONDE - {name} dichiara sha256={expected}, lo sha256 reale di questo file è {actual}. File sbagliato, download danneggiato o manifest obsoleto: scrittura rifiutata.
ERR_HMAC_NOT_32_BYTES={name}: hmac_sha256 non è composto da 32 byte esadecimali
LOG_USING_PUBLISHED_SIGNATURE=Si usa la firma pubblicata nel manifest (chiave: {kind}).
LOG_DEV_KEY_NOTE=NOTA: firmato con la chiave di sviluppo PUBBLICA: lo accettano solo le schede il cui bootloader è stato compilato con la stessa chiave.
LOG_SIGNING_LOCALLY=Nessuna firma pubblicata: firma locale con la chiave {board} di urtc_config.json.
ERR_NO_SIGNATURE_NO_KEY=Questa immagine non ha una firma pubblicata (hmac_sha256 in <file>.manifest.json) e non è configurata alcuna chiave di firma {board}. Usa un'immagine della build URTC (include il suo .manifest.json) oppure, per un'immagine compilata da te su una scheda da banco, imposta "{option}" in urtc_config.json.
ERR_FIRMWARE_EMPTY=Il file del firmware è vuoto
ERR_FIRMWARE_TOO_BIG_MAIN=Il firmware è di {size} byte e supera lo slot principale di {max} byte: non si invia un aggiornamento che il bootloader rifiuterebbe comunque
ERR_PAGE_ACK_SHORT=L'ACK della pagina {page} era di soli {got} byte (ne servono almeno 4): probabilmente il rumore sul bus ha corrotto il frame
ERR_PAGE_ACK_MISMATCH=ACK di pagina non corrispondente: attesa la pagina {expected}, il bootloader ha confermato la {got}
ERR_BOOTLOADER_FAILURE_REASON=Il bootloader ha segnalato un errore: {name} - {reason}
ERR_BOOTLOADER_FAILURE=Il bootloader ha segnalato un errore: {name}
ERR_TIMEOUT_FINAL_VERIFICATION=Timeout in attesa del risultato della verifica finale
ERR_FIRMWARE_TOO_BIG_SLAVE=Il firmware è di {size} byte e supera lo slot principale di {max} byte dello slave di espansione: non si invia un aggiornamento che il suo bootloader rifiuterebbe comunque
ERR_SLAVE_BRIDGE_STALLED=Il ponte I2C dello slave di espansione ha smesso di rispondere ({count} richieste di avanzamento 0x216 consecutive senza risposta) dopo l'invio di {offset} byte su {size}: si interrompe invece di continuare a inviare il resto dell'immagine a un ponte bloccato o scollegato. Controlla che il chip slave sia presente e il collegamento I2C integro, poi riprova.
ERR_TIMEOUT_SLAVE_FINAL_VERIFICATION=Timeout in attesa del risultato della verifica finale dello slave di espansione
ERR_TIMEOUT_SLAVE_STATUS=Timeout in attesa che lo slave di espansione segnali lo stato 0x{status}
